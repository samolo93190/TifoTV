<?xml version="1.0" encoding="utf-8"?>
<!-- TifoTV: replaces core's OwnTV icon of the same name, so every launcher alias shows the TifoTV logo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/tifotv_icon_bg"/>
    <foreground android:drawable="@mipmap/tifotv_icon_foreground"/>
    <monochrome android:drawable="@drawable/tifotv_icon_monochrome"/>
</adaptive-icon>
